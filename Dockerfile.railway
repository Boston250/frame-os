FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_PUBLIC_FRAME_API_MODE=live
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache nginx gettext
ENV NODE_ENV=production \
    NEXT_PUBLIC_FRAME_API_MODE=live \
    API_PORT=4000 \
    EXPORT_DIRECTORY=/tmp/frame-exports
COPY --from=build /app ./
COPY deploy/railway-nginx.conf.template /etc/nginx/templates/frame-os.conf.template
RUN chmod +x deploy/railway-start.sh
CMD ["./deploy/railway-start.sh"]
