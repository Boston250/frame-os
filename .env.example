NODE_ENV=production
NEXT_PUBLIC_FRAME_API_MODE=live
APP_URL=https://frame-os.example.com
DATABASE_URL=postgresql://frame_os:change-me@postgres:5432/frame_os
# Optional direct PostgreSQL connection used by migrations and backups.
# For Neon, DATABASE_URL should be pooled and this value should be direct.
DATABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
API_PORT=4000
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-64-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
BACKUP_DESTINATION=
EXPORT_DIRECTORY=/var/lib/frame/exports
FRAME_BOOTSTRAP_PASSWORD=
